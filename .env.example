# Nubra Trading Backend - Environment Variables Template
# Copy this to .env and fill in your actual values

# Application
APP_NAME=nubra-realtime-backend
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080

# Database (optional - set USE_DATABASE=true to enable)
USE_DATABASE=false
DB_HOST=localhost
DB_NAME=nubra
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_SCHEMA=public

# Redis (optional)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Market Data Settings
STRIKE_RADIUS=15
CANDLE_INTERVAL_MINUTES=3
MARKET_TIMEZONE=Asia/Kolkata
SUBSCRIBE_SDK_OHLCV=false
SUBSCRIBE_SDK_OPTION_CHAIN=true

# Nubra Configuration
NUBRA_ENV=UAT
NUBRA_EXCHANGE=NSE
ENABLE_NUBRA_SOCKET=true
INITIAL_NIFTY_PRICE=22000.0

# Nubra Authentication - Session Tokens (fast path)
# Get these from setup_totp.py or enroll_totp.py
NUBRA_AUTH_TOKEN=
NUBRA_X_DEVICE_ID=
NUBRA_SESSION_TOKEN=

# Nubra Authentication - TOTP Credentials (fallback)
# Required if session tokens are expired
PHONE_NO=
MPIN=
NUBRA_TOTP_SECRET=

# Queue & Database Settings
QUEUE_MAXSIZE=100000
DB_BATCH_SIZE=500
DB_FLUSH_INTERVAL_MS=1000
