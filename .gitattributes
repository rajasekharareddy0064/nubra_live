# Set default behavior to automatically normalize line endings
* text=auto

# Shell scripts should use LF
*.sh text eol=lf

# PowerShell scripts can use CRLF
*.ps1 text eol=crlf

# Python files should use LF
*.py text eol=lf

# Docker and YAML files should use LF
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Markdown files
*.md text eol=lf

# Environment files
.env* text eol=lf
